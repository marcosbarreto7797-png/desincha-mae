# ===== Produção (VPS self-host) — copie para .env.production e preencha =====
# NÃO comitar o .env.production real.

# URL do projeto Supabase Cloud (Settings → API → Project URL):
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Chaves geradas no .env do Supabase self-hosted (ANON_KEY / SERVICE_ROLE_KEY):
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# URL pública do app (Caddy):
NEXT_PUBLIC_SITE_URL=https://app.seudominio.com.br
APP_URL=https://app.seudominio.com.br

# Em produção, usuárias são criadas pelo webhook Kiwify → deixe false:
NEXT_PUBLIC_PERMITIR_AUTO_CADASTRO=false

# Cron semanal (gere um valor forte: openssl rand -hex 32):
CRON_SECRET=

# E-mail transacional (Resend) — Fase 6:
RESEND_API_KEY=re_...
EMAIL_FROM="Desincha Mãe <ola@seudominio.com.br>"

# Kiwify (webhook) — Fase 5:
KIWIFY_WEBHOOK_TOKEN=
NEXT_PUBLIC_KIWIFY_CHECKOUT_URL=https://pay.kiwify.com.br/xxxxx

# Web Push (VAPID) — Fase 6 (eu gero as chaves):
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
